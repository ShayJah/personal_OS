    },
    {
      "claim": "Shay chose warm-clean and moody-warm feeds, chocolate/caramel and olive/oat, tall sporty caps and a chill energy level (2 of 5).",
      "evidence": "measured",
      "source": "user vibe form"
    },
    {
      "claim": "Nested bands with equal stroke and gap stay readable at avatar size when reduced to one ring and the core.",
      "evidence": "practice",
      "source": "references/logo.md"
    }
