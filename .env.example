# Auth.js / NextAuth secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth app credentials (Google Cloud Console — OAuth client, "Web
# application" type). Used for sign-in itself (requests Calendar scope up
# front so Calendar is auto-linked at login), plus Google Calendar sync and
# Gmail draft creation. Add ALL THREE redirect URIs below to this one OAuth
# client, and enable the Gmail API for the project:
#   <homepage-url>/api/auth/callback/google
#   <homepage-url>/api/integrations/google-calendar/callback
#   <homepage-url>/api/integrations/gmail/callback
# On the OAuth consent screen, add each teammate's Google account email
# under "Test users" — keeps the app in Testing mode (no Google review
# needed) while still allowing the Calendar scope for up to 100 users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# invoking scheduled routes under app/api/cron/*. Generate with
# `openssl rand -base64 32` and set the same value in Vercel's env vars.
CRON_SECRET=
