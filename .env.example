# Auth.js / NextAuth secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# GitHub OAuth app credentials (https://github.com/settings/developers)
# Homepage URL: your deployed URL (or http://localhost:3000 for dev)
# Callback URL: <homepage-url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Agents page (optional). Unset = the page is hidden from everyone.
# Comma-separated sign-in emails allowed to see the page and approve tasks.
AGENTS_OWNER_EMAILS=
# "owner/name" of the private task-board repo.
AGENTS_BOARD_REPO=
# Fine-grained GitHub token limited to that one repo: Issues read/write. Server-side only; never commit it.
AGENTS_GITHUB_TOKEN=
